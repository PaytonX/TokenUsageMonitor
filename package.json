{
  "name": "token-usage-monitor",
  "version": "0.3.1",
  "description": "Lightweight transparent desktop widget for AI token usage monitoring",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:mac": "RUSTUP_TOOLCHAIN=stable tauri dev",
    "tauri:build:mac": "RUSTUP_TOOLCHAIN=stable tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.6.4",
    "svelte": "^5.1.9",
    "svelte-check": "^4.0.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
